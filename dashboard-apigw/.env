APP_NAME=DevOps Dashboard
APP_VERSION=1.0.0
DEBUG=true

# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-super-secret-key-replace-in-production-32chars!!

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# SQLite for local testing; swap for PostgreSQL in production
DATABASE_URL=sqlite:///./devopsdashboard.db

# Comma-separated allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# AI Configuration
AI_PROVIDER=gemini
AI_SENSITIVE_FIELDS=password,secret,token,key

# OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini
OPENAI_INSIGHTS_MODEL=gpt-4o

# Gemini Configuration
GEMINI_API_KEY="xxxxxx"
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_INSIGHTS_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
